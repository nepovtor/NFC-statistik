DOMAIN=example.com
PUBLIC_BASE_URL=https://example.com
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_LOGIN=admin
# Generate a real hash with:
# python3 -m nfc_app.auth hash-password "StrongAdminPass123!"
ADMIN_PASSWORD_HASH=pbkdf2_sha256$200000$replace_me$replace_me
TRUSTED_PROXY_NETWORKS=127.0.0.1/32,::1/128,172.16.0.0/12
SESSION_TOUCH_INTERVAL_MINUTES=5
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
VISIT_DATA_EXPOSURE=masked
VISIT_RETENTION_DAYS=180
ADMIN_ALLOWED_NETWORKS=127.0.0.1/32,::1/128,100.64.0.0/10,fd7a:115c:a1e0::/48
